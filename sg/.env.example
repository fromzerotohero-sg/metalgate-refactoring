# =============================================================================
# SilverGate backend — environment reference
# =============================================================================
# Copy to `.env` for local development, or set these as environment variables in
# the Vercel project. Never commit real values.
#
# In production the application REFUSES TO START if a required value is missing.
# That is deliberate: the previous deployment silently fell back to literal
# "dev-secret-key" values. See architecture/README.md.
# =============================================================================

# ── Environment ──────────────────────────────────────────────────────────────
# development | production
SG_ENV=development
SG_LOG_LEVEL=INFO

# ── Required secrets ─────────────────────────────────────────────────────────
# Generate each with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET=
INTERNAL_API_KEY=
# The admin API's first lock: a high-entropy shared secret. Generate one with
# `python security_enhancements.py`.
ADMIN_CODE=

# Second lock: TOTP. Generate with `python totp.py`, then scan the printed
# otpauth:// URI into an authenticator app. REQUIRED in production — without it the
# admin API answers 503 rather than falling back to the shared code alone.
SG_ADMIN_TOTP_SECRET=

# Third lock (opt-in): comma-separated addresses/CIDRs allowed to reach the admin
# API at all. Strongly recommended when the operator's address is stable; omitted
# means "any address", which is logged as a warning at startup.
SG_ADMIN_IP_ALLOWLIST=


# ── Data store (required) ────────────────────────────────────────────────────
# Supabase is used strictly as managed Postgres, via PostgREST. Use the
# service-role key: it is only ever sent server-side and must never reach a
# browser.
SUPABASE_URL=
SUPABASE_KEY=

# ── The session cookie ───────────────────────────────────────────────────────
# This cookie is the user's only credential and the mechanism that keeps them
# signed in across every platform.
#
# SG_SESSION_COOKIE_DOMAIN must be the brand's registrable domain, including the
# leading dot, e.g. ".fromzerotohero.io". Without it the cookie is host-only and
# platforms on sibling subdomains will not share the session.
#
# It must be a CUSTOM domain. Do not use ".vercel.app": it is on the Public
# Suffix List and browsers reject cookies scoped to it.
SG_SESSION_COOKIE_DOMAIN=.fromzerotohero.io
# Refuse to start if SG_SESSION_COOKIE_DOMAIN is unset, because a host-only cookie
# silently breaks cross-platform single sign-on. Set to false only if every
# platform uses the SSO code-exchange path instead of the cookie.
SG_REQUIRE_SHARED_COOKIE=true
SG_SESSION_COOKIE_NAME=sg_session
# Set to false only for plain-HTTP local development.
SG_SESSION_COOKIE_SECURE=true
# Lax is correct when SilverGate and its platforms share a registrable domain.
SG_SESSION_COOKIE_SAMESITE=Lax

# Sessions do not expire. Only logout ends them. These knobs exist for tuning:
#  - TTL is the cookie's sliding window (400 days is Chrome's maximum).
#  - RENEW_AFTER re-issues the cookie so an active user is never asked to sign in.
#  - IDLE_TIMEOUT (0 = disabled) would end a session after inactivity.
SG_SESSION_TTL_DAYS=400
SG_SESSION_RENEW_AFTER_HOURS=24
SG_SESSION_IDLE_TIMEOUT_DAYS=0
SG_SESSION_TOUCH_INTERVAL_MINUTES=5

# ── Short-lived platform tokens ──────────────────────────────────────────────
SG_ACCESS_TOKEN_TTL_MINUTES=10
SG_ACCESS_TOKEN_ISSUER=silvergate
SG_SSO_CODE_TTL_SECONDS=60
# Streamers are not `users`, so they cannot use the revocable session store.
SG_STREAMER_TOKEN_TTL_DAYS=400

# ── Public URLs ──────────────────────────────────────────────────────────────
# The frontend is served from the brand APEX and the API from an `api.`
# subdomain. Same registrable domain, so the session cookie (scoped below) is
# sent to both and the whole flow is same-site — no redirect handshake needed.
SG_APP_URL=https://fromzerotohero.io
SG_LOGIN_URL=https://fromzerotohero.io/login
# Where a user lands when we have no better destination: after verifying from a
# link with no `redirect`, and on returning from the Stripe portal. The frontend
# serves the workspace at /account but keeps /dashboard as an alias, so either
# value works.
SG_DASHBOARD_URL=https://fromzerotohero.io/account
SG_API_PUBLIC_URL=https://api.fromzerotohero.io
# Where Stripe returns the payer. Absolute and configuration-driven, so a
# subscription always lands on SilverGate's own account page even when a platform
# started the checkout. Defaults to SG_DASHBOARD_URL with ?subscription=success
# or ?subscription=cancel appended.
# SG_CHECKOUT_SUCCESS_URL=https://fromzerotohero.io/account?subscription=success
# SG_CHECKOUT_CANCEL_URL=https://fromzerotohero.io/account?subscription=cancel

# The verification email links to the FRONTEND page, which posts the token to
# /api/sso/verify-email and receives the session cookie. That is the chosen flow:
# a real page can show the user what is happening and carry a `redirect` back to
# the platform they came from.
#
# Set true only to point the link straight at the API instead, which verifies and
# creates the session in one navigation with no page in between (useful as a
# fallback if the frontend is ever unavailable; it skips the frontend entirely).
SG_EMAIL_VERIFY_VIA_API=false

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated. Every origin that will call the API from a browser. An
# unlisted origin gets 403 {"error": "Origin not allowed"} on cookie requests, so
# this must include the frontend and any platform frontend.
SG_CORS_ORIGINS=https://fromzerotohero.io,https://efootball.fromzerotohero.io,http://localhost:3000

# ── Rate limiting ────────────────────────────────────────────────────────────
# An in-memory store is per-instance and therefore enforces nothing on
# serverless hosting. REQUIRED in production: the app refuses to start with
# memory:// there, because login, the admin code and password reset would all
# be brute-forceable. Use a shared store, e.g.
#   SG_RATELIMIT_STORAGE_URI=redis://default:PASSWORD@HOST:PORT
# Only set the flag below if you genuinely accept per-instance limits.
SG_RATELIMIT_STORAGE_URI=memory://
SG_RATELIMIT_ENABLED=true
SG_ALLOW_IN_MEMORY_RATELIMIT=false

# ── Platforms ────────────────────────────────────────────────────────────────
# JSON object keyed by client_id. `origins` matter for same-domain SSO and CORS;
# `redirect_uris` are matched EXACTLY during the cross-domain code exchange;
# `api_key` authenticates the server-to-server token exchange and introspection.
# A platform with no api_key must use PKCE instead.
SG_PLATFORMS={"efootball":{"name":"eFootball Coaching","origins":["https://efootball.fromzerotohero.io"],"redirect_uris":["https://efootball.fromzerotohero.io/auth/callback"],"api_key":""}}

# ── Stripe ───────────────────────────────────────────────────────────────────
# Subscriptions only. One-time credit packs have been retired.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ── Plans ────────────────────────────────────────────────────────────────────
# Monthly subscriptions. Each paid invoice RESETS the allowance to `credits`;
# leftover credits do not roll over. Prices are EUR cents.
#
# Stripe price IDs are created in the Stripe dashboard, hence env vars. A plan
# with no price ID is still listed, but checkout returns 503 for it rather than
# charging the wrong amount.
#   lite  €7.99  / month → 150 credits
#   pro   €14.99 / month → 300 credits
#   ultra €29.99 / month → 750 credits
STRIPE_PRICE_LITE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ULTRA=

# Optional: reshape the plans (or add one) as JSON. Overrides individual fields.
# SG_PLANS={"pro":{"credits":350}}

# The upgrade call to action appears once usage reaches this percentage of the
# plan allowance — i.e. "within 10% of the limit".
SG_UPGRADE_CTA_THRESHOLD_PERCENT=90
# Where that call to action sends the user.
SG_STORE_URL=https://fromzerotohero.io/pricing

# ── Request limits ───────────────────────────────────────────────────────────
# Largest accepted request body. The biggest legitimate payload is a campaign
# preview with an inline base64 image (capped at 2 MB of characters).
SG_MAX_CONTENT_LENGTH=4194304
# Hosts this API will answer for. Optional: SilverGate builds no URL from the
# Host header, so leave unset unless you want the check (it would also reject
# Vercel preview deployments).
SG_TRUSTED_HOSTS=

# ── Policy ───────────────────────────────────────────────────────────────────
# Password policy, enforced on registration, change and reset. The upper bound
# is not a strength rule: it stops a client making the hasher do unbounded work.
SG_MIN_PASSWORD_LENGTH=8
SG_MAX_PASSWORD_LENGTH=256

# Referral reward. Always granted as TEMPORARY credits, never plan credits: the
# plan bucket belongs to Stripe and a bonus must not inflate the allowance.
# A year reads as permanent while still lapsing eventually.
SG_REFERRAL_BONUS_CREDITS=50
SG_REFERRAL_BONUS_TTL_DAYS=365

# Credits granted at registration, as a temporary credit.
SG_SIGNUP_BONUS_CREDITS=10

# Default lifetime (days) of a temporary credit grant when the granting call
# names neither expires_at nor expires_in_days.
SG_TEMP_GRANT_TTL_DAYS=7

# ── Email (Resend) ───────────────────────────────────────────────────────────
RES_API_KEY=
EMAIL_FROM=info@fromzerotohero.io
EMAIL_FROM_NAME=SilverGate
# Must be an absolute URL on the FRONTEND origin: the email links here, the page
# then posts the token to /api/sso/verify-email and receives the session cookie.
EMAIL_VERIFICATION_URL=https://fromzerotohero.io/verify-email

# ── Google sign-in (optional) ────────────────────────────────────────────────
# Google acts as an external identity provider: the ID token it returns is
# verified, and an ordinary SilverGate session is issued from it. Leave both
# unset to disable the feature — the endpoints then report `?oauth=unavailable`
# and the frontend can hide the button.
#
# Create an OAuth 2.0 Client ID of type "Web application" in the Google Cloud
# console and add the callback below as an authorized redirect URI. It must
# match EXACTLY, or Google refuses the request before it ever reaches this
# service. GOOGLE_CLIENT_SECRET is server-side only: never expose it through a
# frontend variable or a browser bundle.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Defaults to <SG_API_PUBLIC_URL>/api/auth/google/callback.
# SG_GOOGLE_REDIRECT_URI=https://api.fromzerotohero.io/api/auth/google/callback

# ── OpenAI (admin usage proxy) ───────────────────────────────────────────────
# Only used by the admin endpoints that read live usage from OpenAI. SilverGate
# does not call the completions API itself: platforms log their own AI usage
# into the `ai_usage_logs` table and the admin platform reads that.
OPENAI_API_KEY=
