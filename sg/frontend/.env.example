# Where the browser sends API calls.
#
# Keep this RELATIVE whenever the frontend proxies the API (see API_PROXY_TARGET
# below). A relative value makes every call same-origin, so the session cookie is
# first-party — which is the only arrangement that works between two *.vercel.app
# hosts: they are different registrable domains, and browsers drop third-party
# cookies, so a login that succeeds would never persist.
NEXT_PUBLIC_API_URL=/api

# Where the proxy in next.config.mjs forwards /api/*.
#
# Read at build time only and never shipped to the browser, which is why it is not
# a NEXT_PUBLIC_ variable. Leave it unset to skip the proxy and call
# NEXT_PUBLIC_API_URL directly — for local development against a plain-HTTP API,
# for example, where that absolute URL is the simplest thing that works.
API_PROXY_TARGET=https://api.fromzerotohero.io
