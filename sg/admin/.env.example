# Browser API base. Keep /api in production so the admin headers are sent only
# to this origin; configure API_PROXY_TARGET below to reach SilverGate.
NEXT_PUBLIC_API_URL=/api

# REQUIRED in production (Vercel env): server-side target for Next's same-origin
# API proxy, without a trailing /api. If unset, every API call 404s and the login
# gate fails with a generic error — nothing else will look broken.
API_PROXY_TARGET=https://v2.fromzerotohero.io
