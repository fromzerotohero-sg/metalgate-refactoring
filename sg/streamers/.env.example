# Browser API base. Keep /api in production so the bearer token is sent only to
# this origin; configure API_PROXY_TARGET below to reach the SilverGate service.
NEXT_PUBLIC_API_URL=/api

# Server-side target for Next's same-origin API proxy, without a trailing /api.
# API_PROXY_TARGET=https://v2.fromzerotohero.io

# URL of the central user registration page used in streamer referral links.
# NEXT_PUBLIC_SIGNUP_URL=https://www.fromzerotohero.io/register
